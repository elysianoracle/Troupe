# --- Core ---
TROUPE_DATA_DIR=/var/lib/troupe
# keep local; put Caddy/nginx with TLS in front
TROUPE_HOST=127.0.0.1
TROUPE_PORT=8080
TROUPE_PUBLIC_URL=https://troupe.example.com
# generated into $TROUPE_DATA_DIR/admin_token if unset
# TROUPE_ADMIN_TOKEN=

# --- Model ---
# anthropic | openai_compat
TROUPE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# per-agent override in the UI (e.g. claude-sonnet-5-5 for cheaper workers)
TROUPE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TROUPE_EFFORT=medium
# server-side refusal fallback
TROUPE_FALLBACKS=true
# Anthropic server-side web search tool
TROUPE_WEB_SEARCH=true
# Local / other models instead (Ollama, vLLM, OpenRouter...):
# TROUPE_LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# TROUPE_MODEL=qwen3:4b

# --- Sandboxes (sized for an 8 GB VPS) ---
TROUPE_SANDBOX=docker
TROUPE_SANDBOX_IMAGE=troupe-sandbox:latest
# set to runsc after installing gVisor for stronger isolation
TROUPE_SANDBOX_RUNTIME=
TROUPE_SANDBOX_MEMORY=1g
TROUPE_SANDBOX_CPUS=1.0
# use 2 if you also run a local model
TROUPE_SANDBOX_MAX_ACTIVE=4
TROUPE_SANDBOX_IDLE_MINUTES=10
TROUPE_MAX_PARALLEL_TASKS=3
TROUPE_MAX_STEPS=40
TROUPE_MAX_HOPS=12
# comma-separated domains agents may not browse
TROUPE_BLOCKED_DOMAINS=

# --- AgentMail: a real inbox per agent (recommended) ---
# Paste the key in the UI's Vault tab as agentmail_api_key, or set it here.
AGENTMAIL_API_KEY=
# Optional: a domain you verified in AgentMail (default agentmail.to)
TROUPE_AGENTMAIL_DOMAIN=
# Optional: address prefix, e.g. acme -> acme-scout@agentmail.to (default troupe-xxxx)
TROUPE_AGENTMAIL_PREFIX=

# --- Email via your own mailbox instead (one mailbox, plus-addressed per agent) ---
# me@example.com -> agents are me+scout@example.com
TROUPE_EMAIL_ADDRESS=
TROUPE_IMAP_HOST=
TROUPE_IMAP_USER=
TROUPE_IMAP_PASSWORD=
TROUPE_SMTP_HOST=
TROUPE_SMTP_PORT=587
TROUPE_SMTP_USER=
TROUPE_SMTP_PASSWORD=
TROUPE_EMAIL_POLL_SECONDS=120
TROUPE_EMAIL_DAILY_LIMIT=30

# --- Telegram ---
# from @BotFather
TROUPE_TELEGRAM_TOKEN=
# your numeric user id (ask @userinfobot)
TROUPE_TELEGRAM_OWNER_ID=

# --- SMS (optional; US needs A2P 10DLC registration first) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
