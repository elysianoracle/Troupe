#!/usr/bin/env python3
"""Safely store an API key in /etc/troupe/troupe.env and restart Troupe.

  sudo troupe-setkey AGENTMAIL_API_KEY
  sudo troupe-setkey OPENAI_API_KEY
  sudo troupe-setkey ANTHROPIC_API_KEY

The key is read without echo. Stray spaces, quotes, a pasted "NAME=" prefix or "export " are
removed. The key is never printed; only a short fingerprint is shown so you can compare keys.
"""
import getpass
import hashlib
import os
import re
import subprocess
import sys

ENV = os.environ.get("TROUPE_ENV", "/etc/troupe/troupe.env")
PREFIXES = {"AGENTMAIL_API_KEY": "am_", "ANTHROPIC_API_KEY": "sk-ant-"}

if len(sys.argv) != 2 or not re.fullmatch(r"[A-Z][A-Z0-9_]*", sys.argv[1]):
    sys.exit("usage: sudo troupe-setkey NAME   (e.g. AGENTMAIL_API_KEY)")
name = sys.argv[1]

raw = getpass.getpass(f"Paste {name} (hidden): ")
value = raw.strip().strip("\"'")
value = re.sub(r"^(export\s+)?[A-Z][A-Z0-9_]*\s*=\s*", "", value).strip().strip("\"'")
if not value or re.search(r"\s", value):
    sys.exit("That doesn't look like a single key (it's empty or contains spaces). Nothing was changed.")
want = PREFIXES.get(name)
if want and not value.startswith(want):
    sys.exit(f"{name} keys start with '{want}'. Nothing was changed.")

lines = open(ENV, encoding="utf-8").read().splitlines()
out, done = [], False
for line in lines:
    if line.startswith(f"{name}="):
        if not done:
            out.append(f"{name}={value}")
            done = True
        continue  # drop duplicates
    out.append(line)
if not done:
    out.append(f"{name}={value}")
tmp = ENV + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    f.write("\n".join(out) + "\n")
st = os.stat(ENV)
os.chown(tmp, st.st_uid, st.st_gid)
os.chmod(tmp, st.st_mode & 0o777)
os.replace(tmp, ENV)

print(f"saved {name} (fingerprint {hashlib.sha256(value.encode()).hexdigest()[:8]}, {len(value)} chars)")
subprocess.run(["systemctl", "restart", "troupe"], check=False)
print("Troupe restarted")
